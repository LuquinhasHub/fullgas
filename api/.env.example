# ============================================================
# Configuração da API Fullgas — copie este arquivo para ".env"
# e preencha com os seus dados. NUNCA suba o .env para o Git.
# ============================================================

# --- Conexão com o SQL Server ---
# Para a instância PADRÃO (INSTANCE NAME = MSSQLSERVER), use o host puro:
DB_SERVER=
DB_PORT=
DB_NAME=

# Autenticação do banco.
# Opção A (recomendada p/ deploy): usuário e senha do SQL Server (SQL Auth).
DB_USER=
DB_PASSWORD=
# Criptografia da conexão. Em produção use true; localmente pode ser false.
DB_ENCRYPT=false
DB_TRUST_CERT=true

# --- Servidor HTTP ---
PORT=

# Origem permitida no CORS (o endereço de onde o front é servido), separando
# várias por vírgula. Ex.: http://localhost:5500 (Live Server), https://seusite.com
#
# VAZIO = libera apenas localhost e rede local (192.168.x, 10.x, 172.16-31.x).
# Isso já cobre o desenvolvimento; em produção o front e a API são servidos na
# MESMA origem pelo Nginx, e requisição de mesma origem não passa por CORS.
# '*' é ignorado (vira o mesmo que vazio): curinga + credenciais permitiria que
# qualquer site da internet chamasse esta API com a sessão do usuário logado.
CORS_ORIGIN=

# --- Segurança ---
# Chave para assinar os tokens JWT. OBRIGATÓRIA: a API se recusa a subir sem
# ela, ou com menos de 32 caracteres. Não existe valor padrão — um padrão
# publicado no código deixaria qualquer pessoa forjar um token de admin.
# Gere uma nova assim:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Trocar esta chave DESLOGA todo mundo (todos os tokens em circulação morrem).
JWT_SECRET=
JWT_EXPIRES=

# --- Integração Tiny ERP ---
# Token da API v2. Gere em: Tiny → Menu → Início → Extensões → Token API.
TINY_TOKEN=
# Sincronização automática (node-cron): intervalo em MINUTOS entre as rodadas
# que espelham todos os produtos Tiny (mesmo lote do botão "Sincronizar" do
# admin). Use 1 a 59, ou múltiplos de 60 (60 = 1h). 0 ou vazio = desligado.
# Cada produto custa ~2,2 s (2 requisições, limite do Tiny) — escolha um
# intervalo MAIOR que o tempo de uma rodada do seu catálogo, senão a rodada
# seguinte é pulada. Conta rápida da duração de uma rodada:
#   (produtos x 2 + empresas vinculadas + pedidos aguardando status) x 1,1 s
# Ex.: 32 produtos + 2 empresas + 13 pedidos = ~79 req = ~1,5 min -> 5 min ok.
# ATENÇÃO ao importar o catálogo completo: 7.900 produtos = ~5 h por rodada.
# Nesse ponto o intervalo tem de subir muito (ou a sincronização precisa passar
# a ser incremental, só do que mudou no Tiny).
# Isto NÃO afeta o que o cliente sente na hora: a checagem de estoque do
# checkout, a exportação do pedido e o envio do cadastro editado são imediatos.
TINY_SYNC_INTERVALO_MIN=5

# Timeout de CADA chamada ao Tiny, em ms (vazio = 20000). Sem timeout, uma
# resposta que nunca chega travaria a rodada do cron para sempre — e, com ela,
# todas as rodadas seguintes, sem erro visível no log.
TINY_TIMEOUT_MS=20000

# Exportação de PEDIDOS ao Tiny (1 = ligado; vazio/0 = desligado).
# Ligado, cada compra no site: (1) checa o saldo REAL no Tiny antes de fechar
# (o estoque é compartilhado com outro e-commerce) e (2) cria o pedido no Tiny
# já 'aprovado', baixando o estoque lá na hora. IMPORTANTE: configure a conta
# do Tiny para "lançar estoque na aprovação do pedido".
TINY_EXPORTAR_PEDIDOS=

# Sincronização do CADASTRO de clientes com o Tiny, nos DOIS sentidos
# (1 = ligado; vazio/0 = desligado):
#   • No cadastro/edição da concessionária no portal, cria/atualiza o contato
#     correspondente no Tiny (casado pelo CNPJ).
#   • A cada rodada do cron, relê os contatos vinculados e reflete no cadastro
#     local o que mudou no Tiny (razão social, fantasia, IE, e-mail, telefone,
#     endereço). O CNPJ é a chave do vínculo e nunca muda.
TINY_SINCRONIZAR_CLIENTES=


# ============================================================
# E-MAIL (SMTP) — hoje usado só pelo "esqueci minha senha".
# ------------------------------------------------------------
# SEM SMTP_HOST o envio entra em MODO DEV: nada sai pela rede e o e-mail
# inteiro (com o link) é impresso no console do servidor. Serve para testar o
# fluxo sem mandar mensagem para ninguém — mas em produção o cliente NUNCA
# recebe o link. Configure antes de publicar.
#
# Gmail/Google Workspace: host smtp.gmail.com, porta 587, e uma SENHA DE APP
# (aponte para uma conta de sistema, não a pessoal). A senha normal não funciona
# com 2FA ligado.
SMTP_HOST=
SMTP_PORT=587
# 1 = TLS implícito (porta 465). Vazio: decide pela porta (465 = sim).
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Remetente exibido. Vazio usa o SMTP_USER.
SMTP_FROM=Fullgas B2B <nao-responda@suaempresa.com.br>

# Endereço público do FRONTEND — base do link que vai no e-mail
# (APP_URL/redefinir?token=...). Sem barra no fim.
#
# DEIXE VAZIO em desenvolvimento: o link passa a nascer com a MESMA origem de
# onde o portal foi aberto (localhost, IP da rede local, etc.), então funciona
# no celular e em outro computador sem configurar nada. Por segurança só são
# aceitas origens locais/de rede privada ou as listadas em CORS_ORIGIN — assim
# ninguém forja o cabeçalho para receber um link de recuperação alheio.
#
# EM PRODUÇÃO preencha com o domínio real: https://portal.suaempresa.com.br
APP_URL=
